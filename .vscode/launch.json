    "version": "0.2.0",
    "configurations": [
        {
            "name": "vitest (headed browser)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "vitest",
                "--browser.headless=false"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
