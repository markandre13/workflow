// this typescript configuration is shared by all builds and visual studio code
{
    "compilerOptions": {
        "outDir": "build",
        "target": "es2024",
        "module": "esnext",
        "moduleResolution": "bundler",
        "traceResolution": false,
        "lib": ["ESNext", "DOM"],
        "types": [
            "node",
            "vitest/globals",
            "chai",
            "chai-almost",
            "chai-string"
        ],
        "paths": {
            "shared/*": ["./src/shared/*"],
            "client/*": ["./src/client/*"]
        },
        "incremental": false,
        "jsx": "react-jsx",
        "jsxImportSource": "toad.jsx",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "strict": true,
        "strictNullChecks": true,
        "allowJs": false,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "sourceMap": true,
    },
    "include": [
        "src/**/*.ts",
        "src/client/views/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
    ],
    "exclude": [
        "node_modules"
    ]
}
